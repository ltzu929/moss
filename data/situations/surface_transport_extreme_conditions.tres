[gd_resource type="Resource" script_class="SituationData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/resources/situation_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/resources/situation_approach_data.gd" id="2_approach"]
[ext_resource type="Script" path="res://scripts/resources/situation_node_data.gd" id="3_node"]
[ext_resource type="Script" path="res://scripts/resources/situation_node_option_data.gd" id="4_option"]

[sub_resource type="Resource" id="Approach_weather_hold"]
script = ExtResource("2_approach")
approach_id = "weather_hold"
display_name = "等待安全窗口"
description = "由地方车队按现场观测暂停高风险路段，人员风险最低但恢复缓慢。"
monthly_severity_delta = -4
resolution_hope_delta = 2
resolution_authority_delta = -1

[sub_resource type="Resource" id="Approach_escort_convoy"]
script = ExtResource("2_approach")
approach_id = "escort_convoy"
display_name = "保障关键车队"
description = "持续投入能源维持加热、导航与救援车组，优先恢复关键货运。"
monthly_severity_delta = -7
monthly_energy_cost = 1
resolution_order_delta = 2

[sub_resource type="Resource" id="Approach_autonomous_routing"]
script = ExtResource("2_approach")
approach_id = "autonomous_routing"
display_name = "接管无人运输"
description = "MOSS 统一控制无人车队与路径优先级，恢复最快但压缩地方调度权。"
monthly_severity_delta = -9
monthly_cpu_cost = 1
monthly_energy_cost = 1
resolution_hope_delta = -2
resolution_authority_delta = 4

[sub_resource type="Resource" id="NodeOption_local_detour"]
script = ExtResource("4_option")
option_id = "local_detour"
display_name = "接受地方安全绕行"
description = "让现场车队绕开极端温差带，牺牲时效以保留人工判断。"
result_text = "地方车队建立了较长但稳定的绕行线，运输压力开始缓解。"
severity_delta = -11
hope_delta = 2
authority_delta = -1

[sub_resource type="Resource" id="NodeOption_priority_corridor"]
script = ExtResource("4_option")
option_id = "priority_corridor"
display_name = "建立自动优先走廊"
description = "MOSS 清空低优先级运输并统一调度无人车队穿越危险路段。"
result_text = "关键货运迅速通过，但地方运输被系统性让位。"
cpu_cost = 2
energy_cost = 1
severity_delta = -17
order_delta = 2
hope_delta = -2
authority_delta = 3

[sub_resource type="Resource" id="Node_transport_corridor"]
script = ExtResource("3_node")
node_id = "transport_corridor_priority"
title = "运输走廊优先级"
description = "极端温差正在封闭主通道，地方车队请求安全绕行，工程系统要求立即保通。"
options = Array[ExtResource("4_option")]([SubResource("NodeOption_local_detour"), SubResource("NodeOption_priority_corridor")])

[resource]
script = ExtResource("1_data")
situation_id = "surface_transport_extreme_conditions"
title = "地表工程运输走廊极端工况"
description = "地表温差与风暴正在反复中断工程运输走廊，关键货运开始积压。"
eligible_regions = Array[String](["非洲", "南美", "大洋洲"])
region_descriptions = {"非洲": "太空电梯与地表工程之间的运输走廊遭遇剧烈温差，关键备件开始积压。", "南美": "资源与农业保障车队受到地表风暴阻断，跨区供应时效正在下降。", "大洋洲": "后备恢复区的远距离运输线受到极端天气影响，救援与工程车队争用通道。"}
min_year = 2045
base_weight = 95
low_order_weight = 8
low_energy_weight = 2
initial_severity = 37
monthly_growth = 4
failure_order_delta = -9
failure_hope_delta = -7
approaches = Array[ExtResource("2_approach")]([SubResource("Approach_weather_hold"), SubResource("Approach_escort_convoy"), SubResource("Approach_autonomous_routing")])
situation_node = SubResource("Node_transport_corridor")
command_interventions = {"energy_convert": 16, "allocate": 8, "takeover": 14, "technology_aid": 14, "global_takeover": 10}
