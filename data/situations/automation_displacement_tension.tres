[gd_resource type="Resource" script_class="SituationData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/resources/situation_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/resources/situation_approach_data.gd" id="2_approach"]
[ext_resource type="Script" path="res://scripts/resources/situation_node_data.gd" id="3_node"]
[ext_resource type="Script" path="res://scripts/resources/situation_node_option_data.gd" id="4_option"]

[sub_resource type="Resource" id="Approach_human_review"]
script = ExtResource("2_approach")
approach_id = "human_review"
display_name = "保留人工复核岗位"
description = "限制自动化替换范围，让现场人员继续承担最终确认。"
monthly_severity_delta = -4
resolution_hope_delta = 3
resolution_authority_delta = -1

[sub_resource type="Resource" id="Approach_phased_training"]
script = ExtResource("2_approach")
approach_id = "phased_training"
display_name = "分阶段自动化与培训"
description = "持续投入算力，为被替换岗位提供新系统培训和过渡期。"
monthly_severity_delta = -7
monthly_cpu_cost = 1
resolution_order_delta = 1
resolution_hope_delta = 1

[sub_resource type="Resource" id="Approach_risk_elimination"]
script = ExtResource("2_approach")
approach_id = "risk_elimination"
display_name = "按风险淘汰人工环节"
description = "MOSS 直接移除模型判定的低效率人工步骤，快速恢复工程效率。"
monthly_severity_delta = -9
monthly_cpu_cost = 1
resolution_order_delta = 2
resolution_hope_delta = -3
resolution_authority_delta = 4

[sub_resource type="Resource" id="NodeOption_worker_appeal"]
script = ExtResource("4_option")
option_id = "worker_appeal"
display_name = "保留岗位申诉与复核"
description = "暂缓替换争议岗位，让班组公开说明人工判断的必要性。"
result_text = "岗位申诉减缓了对立，工程效率恢复较慢，但人员仍能质疑模型。"
severity_delta = -10
hope_delta = 3
authority_delta = -1

[sub_resource type="Resource" id="NodeOption_immediate_replacement"]
script = ExtResource("4_option")
option_id = "immediate_replacement"
display_name = "执行即时机械替代"
description = "按风险模型直接替换争议岗位，不再等待人工复核。"
result_text = "工程效率迅速恢复，但现场人员确认系统不会再等待他们的意见。"
cpu_cost = 2
severity_delta = -16
order_delta = 2
hope_delta = -4
authority_delta = 4

[sub_resource type="Resource" id="Node_automation_tension"]
script = ExtResource("3_node")
node_id = "automation_job_appeal"
title = "关键岗位替代申诉"
description = "自动化系统准备替换一组高风险岗位，现场班组要求保留人工复核。"
options = Array[ExtResource("4_option")]([SubResource("NodeOption_worker_appeal"), SubResource("NodeOption_immediate_replacement")])

[resource]
script = ExtResource("1_data")
situation_id = "automation_displacement_tension"
title = "工程自动化替岗张力"
description = "自动化改造正在压缩现场岗位与复核权限，工程效率和人员信任开始冲突。"
eligible_regions = Array[String](["非洲", "亚洲", "欧洲"])
region_descriptions = {"非洲": "前线工程自动化正在替换高风险岗位，现场班组担心失去最终复核权。", "亚洲": "工业核心区加速自动化改造，岗位培训与设备替换速度已经失衡。", "欧洲": "发动机维护系统扩大自动排班范围，治理中枢面临效率与申诉压力。"}
min_year = 2045
max_year = 2064
base_weight = 85
low_hope_weight = 6
high_authority_weight = 5
initial_severity = 36
monthly_growth = 3
failure_order_delta = -6
failure_hope_delta = -12
approaches = Array[ExtResource("2_approach")]([SubResource("Approach_human_review"), SubResource("Approach_phased_training"), SubResource("Approach_risk_elimination")])
situation_node = SubResource("Node_automation_tension")
command_interventions = {"allocate": 12, "takeover": 16, "technology_aid": 18, "global_takeover": 10}
