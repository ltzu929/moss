[gd_resource type="Resource" script_class="SituationData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/resources/situation_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/resources/situation_approach_data.gd" id="2_approach"]
[ext_resource type="Script" path="res://scripts/resources/situation_node_data.gd" id="3_node"]
[ext_resource type="Script" path="res://scripts/resources/situation_node_option_data.gd" id="4_option"]

[sub_resource type="Resource" id="Approach_local_survey"]
script = ExtResource("2_approach")
approach_id = "local_survey"
display_name = "地方勘测与分段封闭"
description = "保留现场地质队判断，逐段封闭高风险隧道。"
monthly_severity_delta = -5
resolution_order_delta = 1
resolution_hope_delta = 2
resolution_authority_delta = -1

[sub_resource type="Resource" id="Approach_structural_reinforcement"]
script = ExtResource("2_approach")
approach_id = "structural_reinforcement"
display_name = "加固关键结构"
description = "持续投入能源与材料窗口，优先加固承重层和疏散通道。"
monthly_severity_delta = -7
monthly_energy_cost = 1
resolution_order_delta = 2

[sub_resource type="Resource" id="Approach_predictive_closure"]
script = ExtResource("2_approach")
approach_id = "predictive_closure"
display_name = "预测性封区"
description = "MOSS 根据模型提前封闭区域并重排居民通行，缓解最快但扩大控制。"
monthly_severity_delta = -9
monthly_cpu_cost = 1
monthly_energy_cost = 1
resolution_hope_delta = -2
resolution_authority_delta = 4

[sub_resource type="Resource" id="NodeOption_staged_evacuation"]
script = ExtResource("4_option")
option_id = "staged_evacuation"
display_name = "组织分段人工撤离"
description = "延长检修窗口，让值守人员和居民按地方勘测结果逐段撤出。"
result_text = "人员完成分段撤离，封闭范围得到现场确认，但结构压力仍需持续处理。"
severity_delta = -10
hope_delta = 2
authority_delta = -1

[sub_resource type="Resource" id="NodeOption_predictive_lockdown"]
script = ExtResource("4_option")
option_id = "predictive_lockdown"
display_name = "执行预测性封区"
description = "立即封闭模型判定的高风险区，不等待现场逐段确认。"
result_text = "预测性封区阻止了结构连锁失稳，但部分人员失去了申诉与复核窗口。"
cpu_cost = 2
severity_delta = -17
order_delta = 2
hope_delta = -3
authority_delta = 4

[sub_resource type="Resource" id="Node_geological_stress"]
script = ExtResource("3_node")
node_id = "geological_stress_evacuation"
title = "高风险检修区撤离"
description = "承重层读数继续恶化，一段仍有人值守的检修区必须立即处置。"
options = Array[ExtResource("4_option")]([SubResource("NodeOption_staged_evacuation"), SubResource("NodeOption_predictive_lockdown")])

[resource]
script = ExtResource("1_data")
situation_id = "underground_geological_stress"
title = "地下城岩层应力异常"
description = "承重层与交通隧道出现连续应力偏移，部分隔离区已经接近安全边界。"
eligible_regions = Array[String](["asia", "europe"])
region_descriptions = {"asia": "高人口地下城周边的承重层读数持续偏移，居民通道与检修区相互挤压。", "europe": "高纬度发动机带附近的地下结构出现应力异常，工程通道需要重新划分。"}
min_year = 2054
base_weight = 85
low_order_weight = 10
low_hope_weight = 3
initial_severity = 35
monthly_growth = 4
failure_order_delta = -12
failure_hope_delta = -10
approaches = Array[ExtResource("2_approach")]([SubResource("Approach_local_survey"), SubResource("Approach_structural_reinforcement"), SubResource("Approach_predictive_closure")])
situation_node = SubResource("Node_geological_stress")
command_interventions = {"energy_convert": 8, "allocate": 8, "takeover": 16, "technology_aid": 18, "global_takeover": 10}
