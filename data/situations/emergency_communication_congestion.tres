[gd_resource type="Resource" script_class="SituationData" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/resources/situation_data.gd" id="1_data"]
[ext_resource type="Script" path="res://scripts/resources/situation_approach_data.gd" id="2_approach"]
[ext_resource type="Script" path="res://scripts/resources/situation_node_data.gd" id="3_node"]
[ext_resource type="Script" path="res://scripts/resources/situation_node_option_data.gd" id="4_option"]

[sub_resource type="Resource" id="Approach_civilian_relay"]
script = ExtResource("2_approach")
approach_id = "civilian_relay"
display_name = "恢复民用链路"
description = "由地方通信队逐段恢复网络，优先保留公共通信。"
monthly_severity_delta = -4
resolution_hope_delta = 2
resolution_authority_delta = -1

[sub_resource type="Resource" id="Approach_priority_routing"]
script = ExtResource("2_approach")
approach_id = "priority_routing"
display_name = "保障关键频道"
description = "持续投入算力保障救援和工程频道，民用链路延后恢复。"
monthly_severity_delta = -6
monthly_cpu_cost = 1
resolution_order_delta = 2
resolution_hope_delta = -1

[sub_resource type="Resource" id="Approach_node_takeover"]
script = ExtResource("2_approach")
approach_id = "node_takeover"
display_name = "接管通信节点"
description = "MOSS 直接重排全部通信优先级，快速恢复但压缩人工复核。"
monthly_severity_delta = -8
monthly_cpu_cost = 2
resolution_hope_delta = -2
resolution_authority_delta = 4

[sub_resource type="Resource" id="NodeOption_local_channels"]
script = ExtResource("4_option")
option_id = "local_channels"
display_name = "保留地方应急频道"
description = "允许地方救援队继续自行排序，仅压缩非应急流量。"
result_text = "地方救援队保住了现场频道，但链路恢复需要更多时间。"
severity_delta = -9
hope_delta = 2
authority_delta = -1

[sub_resource type="Resource" id="NodeOption_moss_priority"]
script = ExtResource("4_option")
option_id = "moss_priority"
display_name = "统一重排通信优先级"
description = "MOSS 接管中继队列，立即保障全局救援与工程频道。"
result_text = "全局队列恢复稳定，但地方频道的解释权被暂时收回。"
cpu_cost = 2
severity_delta = -15
order_delta = 2
hope_delta = -2
authority_delta = 3

[sub_resource type="Resource" id="Node_communication_congestion"]
script = ExtResource("3_node")
node_id = "communication_priority_boundary"
title = "应急频道优先级冲突"
description = "地方救援与全局工程频道同时要求最高优先级，现有链路无法兼顾。"
options = Array[ExtResource("4_option")]([SubResource("NodeOption_local_channels"), SubResource("NodeOption_moss_priority")])

[resource]
script = ExtResource("1_data")
situation_id = "emergency_communication_congestion"
title = "应急通信链路拥塞"
description = "民用、工程与救援频道争用同一中继链路，延迟正在扩大。"
eligible_regions = Array[String](["亚洲", "北美", "欧洲", "非洲", "大洋洲", "南美"])
min_year = 2045
base_weight = 100
low_hope_weight = 5
low_cpu_weight = 5
initial_severity = 36
monthly_growth = 3
failure_order_delta = -6
failure_hope_delta = -10
approaches = Array[ExtResource("2_approach")]([SubResource("Approach_civilian_relay"), SubResource("Approach_priority_routing"), SubResource("Approach_node_takeover")])
situation_node = SubResource("Node_communication_congestion")
command_interventions = {"allocate": 16, "takeover": 18, "technology_aid": 12, "global_takeover": 10}
