[resource]
script = ExtResource("1_event")
event_title = "地下数字纪念网络"
event_time = 2047
event_month = 1
event_region = "北美"
event_description = "数字生命相关公开组织被压制后，地下网络开始以纪念逝者和保存家庭影像为名传播未授权人格片段。"
event_level = "一般事件"
options = Array[ExtResource("2_option")]([SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3")])
