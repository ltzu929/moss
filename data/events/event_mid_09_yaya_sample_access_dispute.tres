[resource]
script = ExtResource("1_event")
event_title = "丫丫样本访问争议"
event_time = 2056
event_month = 1
event_region = "亚洲"
event_description = "下一代 550 平台验证前夜，科研机构内部再次讨论丫丫样本和数字生命相关接口的访问边界。"
