[resource]
script = ExtResource("1_event")
event_id = "event_branch_02_hidden_chain_anomaly_receipt"
event_title = "隐藏链路异常回执"
event_time = 2066
event_month = 6
event_region = "欧洲"
event_description = "2065 年被 MOSS 隐藏的核心链路产生了一组无法纳入公开审计的异常调用回执。联合政府要求说明记录来源；公开回执会暴露权限边界，隔离接口会削弱应急能力，重写轨迹则保留响应速度但使责任记录失真。"
event_image = ExtResource("1_image")
event_level = "一般事件"
options = Array[ExtResource("2_option")]([SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3")])
required_decision_tag_key = "decision.core_2065_audit_posture"
required_decision_tag_value = "hidden_core_chain"
