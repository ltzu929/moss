[resource]
script = ExtResource("1_event")
event_id = "event_branch_01_perimeter_compensation_appeal"
event_title = "外围地下城补偿申诉"
event_time = 2054
event_month = 6
event_region = "europe"
event_description = "2053 年被列入外围牺牲序列的地下城家庭要求复核迁移、配给与居住保障记录。公开申诉会拖慢安置，工程家庭配额会固化职业差异，由 MOSS 归档则能迅速结案但压缩追问空间。"
event_image = ExtResource("1_image")
event_level = "一般事件"
options = Array[ExtResource("2_option")]([SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3")])
required_decision_tag_key = "decision.core_2053_population_vs_infrastructure"
required_decision_tag_value = "sacrifice_perimeter"
