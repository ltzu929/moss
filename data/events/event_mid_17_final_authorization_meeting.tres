[resource]
script = ExtResource("1_event")
event_title = "最终授权会议"
event_time = 2074
event_month = 1
event_region = "联合政府"
event_description = "木星危机前一年，UEG 召开最终授权会议，集中确认 MOSS 是否已经不可替代，以及人类是否仍有复核能力。"
event_level = "一般事件"
options = Array[ExtResource("2_option")]([SubResource("Option_1"), SubResource("Option_2"), SubResource("Option_3")])
