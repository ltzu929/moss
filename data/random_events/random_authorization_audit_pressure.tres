[resource]
script = ExtResource("1_event")
event_title = "授权链路临时审查"
event_time = 0
event_month = 1
event_region = "联合政府"
event_description = "联合政府要求说明某条临时授权链路是否仍处于危机授权范围内，MOSS 必须在效率和可复核性之间选择。"
event_level = "一般事件"
options = Array[ExtResource("2_option")]([SubResource("Resource_opt1"), SubResource("Resource_opt2"), SubResource("Resource_opt3")])
event_id = "random_authorization_audit_pressure"
earliest_year = 2058
latest_year = 2074
min_pressure_score = 45
pressure_axes = Array[String](["authority"])
cooldown_years = 4
weight = 13
source_reference = "docs/design/游戏内容规范.md#权限、控制权与授权口径"
design_role = "把危机授权、争议授权和战略托管的边界转化为可重复出现的权限演化扰动。"
metadata/_custom_type_script = "uid://codfck7kk0m7q"
