[gd_resource type="Resource" script_class="RandomEvent" load_steps=5 format=3 uid="uid://random_authorization_audit"]

[ext_resource type="Script" uid="uid://codfck7kk0m7q" path="res://scripts/resources/random_event.gd" id="1_event"]
[ext_resource type="Script" uid="uid://bl7wa43xriuci" path="res://scripts/resources/event_option.gd" id="2_option"]

[sub_resource type="Resource" id="Resource_opt1"]
script = ExtResource("2_option")
button_text = "开放有限复核"
