[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/main_hud.gd" id="1_main_hud"]
[ext_resource type="PackedScene" path="res://scenes/year_progress.tscn" id="2_year_progress"]

[node name="MainHud" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
