## 结局界面脚本
## 显示游戏结束时的标题、描述和重新开始按钮
extends Control

# ============================================================
# 区域一：信号定义
# ============================================================

## 点击重新开始时发射
signal restart_requested

# ============================================================
# 区域二：生命周期函数
# ============================================================

func _ready() -> void:
	# 初始隐藏，等待游戏结束时显示
	hide()

# ============================================================
# 区域三：公共函数
# ============================================================

## 显示结局界面
## 参数:
##   title   - 标题文本（"失败" 或 "结局"）
##   message - 结局描述（多行文本）
func show_end(title: String, message: String) -> void:
	# 设置文本内容
	$VBoxContainer/EndTitle.text = title
	$VBoxContainer/EndMessage.text = message

	# 显示界面
	show()

## 隐藏结局界面
func hide_end() -> void:
	hide()

# ============================================================
# 区域四：回调函数
# ============================================================

## 重新开始按钮点击回调
func _on_restart_button_pressed() -> void:
	restart_requested.emit()
	hide_end()